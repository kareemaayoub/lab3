<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="card">
        <h2>Login</h2>
        <p class="subtitle">Welcome back, please sign in to continue</p>

        <% if (errors.general) { %>
            <div class="server-error"><%= errors.general %></div>
        <% } %>

        <form action="/login" method="POST" novalidate onsubmit="return validateLogin()">
            <div class="field">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="you@example.com" value="<%= old.email || '' %>">
                <span id="emailError" class="field-error"><%= errors.email || '' %></span>
            </div>
            <div class="field">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" placeholder="Enter your password">
                <span id="passwordError" class="field-error"><%= errors.password || '' %></span>
            </div>
            <button type="submit" class="btn full">Login</button>
        </form>

        <p class="footer">Don't have an account? <a href="/register">Register</a></p>
    </div>

    <script>
        function validateLogin() {
            let email = document.getElementById('email').value.trim();
            let password = document.getElementById('password').value;
            let isValid = true;

            document.getElementById('emailError').innerText = email === '' ? 'Email is required' : '';
            if (email === '') isValid = false;

            document.getElementById('passwordError').innerText = password === '' ? 'Password is required' : '';
            if (password === '') isValid = false;

            return isValid;
        }
    </script>
</body>
</html>