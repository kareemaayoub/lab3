<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit book</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="card wide">
        <%- include('nav', { title: 'Edit book' }) %>

        <form action="/books/<%= book.book_id %>/edit" method="POST" enctype="multipart/form-data">
            <div class="field">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" value="<%= book.title %>">
            </div>
            <div class="field">
                <label for="price">Price</label>
                <input type="text" id="price" name="price" value="<%= book.price %>">
            </div>
            <div class="field">
                <label for="author_id">Author</label>
                <select id="author_id" name="author_id">
                    <% authors.forEach(a => { %>
                        <option value="<%= a.author_id %>" <%= String(book.author_id) === String(a.author_id) ? 'selected' : '' %>>
                            <%= a.name %> (<%= a.author_id %>)
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="field">
                <label for="cover">Cover</label>
                <% if (book.cover) { %><img class="thumb" src="/uploads/<%= book.cover %>" alt="cover"><% } %>
                <input type="hidden" name="old_cover" value="<%= book.cover || '' %>">
                <input type="file" id="cover" name="cover" accept="image/*">
            </div>
            <% if (error) { %><p class="server-error"><%= error %></p><% } %>
            <button type="submit" class="btn">Save</button>
            <a class="btn-outline" href="/books">Cancel</a>
        </form>
    </div>
</body>
</html>
